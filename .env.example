# ───────── Server ─────────
PORT=3000
HOST=127.0.0.1                 # keep loopback unless behind a reverse proxy / firewall
TRUST_PROXY=                   # e.g. 1 when behind nginx/Caddy (needed for correct client IPs)
CORS_ORIGINS=                  # comma-separated allowed origins; empty = CORS disabled
MAX_BODY_KB=256

# ───────── Security ─────────
# Generate with: npm run genkey   (min 24 chars, comma-separate for several keys)
API_KEYS=
# Admin keys can also load/unload/pull models. Leave empty to disable admin endpoints.
ADMIN_API_KEYS=
AUTH_DISABLED=false            # only for local experiments!

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30              # requests per window per API key
IP_RATE_LIMIT_MAX=300          # requests per window per IP (all routes)
AUTH_FAIL_MAX=10               # failed auth attempts per 15 min per IP before blocking

# ───────── Ollama (built in: the gateway downloads and runs it for you) ─────────
MANAGE_OLLAMA=true             # true = if no Ollama is running, start our own (downloaded on first run into DATA_DIR)
OLLAMA_AUTO_DOWNLOAD=true      # false = never download; only use OLLAMA_BIN or an installed ollama
OLLAMA_VERSION=latest          # or pin one, e.g. v0.40.10
CPU_ONLY=true                  # true = run on CPU only (GPU hidden, GPU libraries not kept, num_gpu=0)
OLLAMA_FLAVOR=                 # only used when CPU_ONLY=false: empty = NVIDIA, rocm = AMD GPUs
OLLAMA_BIN=                    # optional: use this existing binary instead
DATA_DIR=data                  # Ollama binary + downloaded models live here
PULL_DEFAULT_MODEL=true        # download the default model on first start if missing
OLLAMA_LOGS=false              # true = show Ollama's own log output
OLLAMA_URL=http://127.0.0.1:11434
REQUEST_TIMEOUT_MS=120000      # hard cap for one generate/chat/embed request
PULL_TIMEOUT_MS=900000

# ───────── Model selection ─────────
MODELS_CONFIG=config/models.json   # allowlist + per-model settings live here
DEFAULT_MODEL=                     # overrides "defaultModel" from models.json
ALLOW_CLIENT_MODEL_CHOICE=true     # false = clients always get the default model

# ───────── Load permanently or not ─────────
#   permanent -> keep_alive=-1 (stay in RAM/VRAM until unloaded)
#   timed     -> unload after KEEP_ALIVE_DURATION of inactivity
#   unload    -> unload right after every request
# A model's own "keepAlive" in models.json overrides this.
KEEP_ALIVE_MODE=timed
KEEP_ALIVE_DURATION=5m
PRELOAD_ON_START=false             # load models flagged "preload": true (or the default model)

# ───────── Resource caps (enforced on every request) ─────────
MAX_CONCURRENT=1               # simultaneous inference requests
MAX_QUEUE=10                   # waiting requests before 429
QUEUE_TIMEOUT_MS=30000
MAX_NUM_CTX=4096               # context window ceiling (RAM/VRAM driver)
MAX_NUM_PREDICT=512            # max generated tokens per request
MAX_NUM_THREAD=                # CPU threads; empty = half of the cores
MAX_NUM_GPU=                   # GPU layers; 0 = CPU only; empty = no cap
MAX_NUM_BATCH=
MAX_PROMPT_CHARS=32000
MAX_MESSAGES=50
MAX_EMBED_INPUTS=64

# ───────── Used only by `npm run ollama` (server-side Ollama caps) ─────────
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=16

# ───────── Automatic model selection ─────────
# true = at startup pick the best model from models.json that fits this machine
# (needs "memoryGb", "paramsB", "quality" on the models you want considered).
AUTO_MODEL=false
AUTO_RAM_GB=                   # override detected RAM (e.g. 12); empty = detect (cgroup-aware)
AUTO_RESERVE_GB=2              # RAM kept free for OS, Node and your bot
AUTO_MIN_TPS=3                 # reject models slower than this many tokens/second
AUTO_BENCHMARK=true            # really load + time each candidate (recommended)
AUTO_PULL=false                # download missing candidate models automatically
